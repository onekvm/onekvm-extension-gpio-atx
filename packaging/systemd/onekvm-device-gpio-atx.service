[Unit]
Description=OneKVM GPIO ATX capability provider
Requires=dbus.service
After=dbus.service
ConditionPathExists=|/run/onekvm/gpio-atx-default.json
ConditionPathExists=|/etc/onekvm/plugins/gpio-atx.json
StartLimitIntervalSec=30
StartLimitBurst=5

[Service]
Type=dbus
BusName=org.onekvm.Device.GPIO1
ExecStart=/usr/libexec/onekvm/onekvm-device-gpio-atx
Restart=on-failure
RestartSec=2s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/etc/onekvm

[Install]
WantedBy=onekvm.service
